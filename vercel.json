{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/l/:path*", "destination": "/api?slug=:path*" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|l/).*)", "destination": "/index.html" }
  ]
}
