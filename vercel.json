{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/l/:slug*", "destination": "/api?slug=:slug*" },
    { "source": "/api/:match*", "destination": "/api?apiRoute=:match*" },
    { "source": "/((?!assets/|api/|l/|favicon|.*\\..*).*)", "destination": "/index.html" }
  ]
}
